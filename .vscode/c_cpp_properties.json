{
  "env": {
    "myIncludePath": ["${workspaceFolder}/include", "${workspaceFolder}/src","${workspaceFolder}/src/modules"
        ,"${workspaceFolder}/src/modules/gcm.cache"],
    "myDefines": ["DEBUG", "MY_FEATURE=1"]
  },
  "configurations": [
    {
      "name": "Win",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": ["${myIncludePath}", "${workspaceFolder}/**"],
      "compilerArgs": ["-fmodules-ts","-x c++","-std=c++20"]
    }
  ],
  "version": 4,
  "enableConfigurationSquiggles": true
}
